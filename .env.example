# FastAPI host/port
APP_HOST=0.0.0.0
APP_PORT=8000

# Directory settings
TEMP_DIR=./tmp
UPLOAD_DIR=./tmp/uploads
AUDIO_CACHE_DIR=./tmp/audio_cache

# Voxtral-compatible inference server settings
TTS_SERVER_BASE_URL=http://127.0.0.1:8001
TTS_SPEECH_ROUTE=/audio/speech
TTS_MODEL=mistralai/Voxtral-4B-TTS-2603
TTS_VOICE=alloy
TTS_AUDIO_FORMAT=mp3
TTS_TIMEOUT_SECONDS=180

# Chunking + sync defaults
MAX_CHUNK_CHARS=900
DEFAULT_SPEED=1.0
MIN_SPEED=0.65
MAX_SPEED=1.75

# Estimated pause weights in seconds (used on frontend as defaults too)
PAUSE_COMMA=0.10
PAUSE_SEMICOLON=0.16
PAUSE_PERIOD=0.24
PAUSE_QUESTION=0.24
PAUSE_PARAGRAPH=0.35
